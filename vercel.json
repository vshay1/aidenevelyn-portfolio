{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/app.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/backend/app.py"
    },
    {
      "src": "/js/(.*)",
      "dest": "/backend/app.py"
    },
    {
      "src": "/resources/(.*)",
      "dest": "/backend/app.py"
    },
    {
      "src": "/(.*).html",
      "dest": "/backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/app.py"
    }
  ]
}